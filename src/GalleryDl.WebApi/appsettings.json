{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GalleryDl": {
    "ExecutablePath": "gallery-dl",
    "WorkRootPath": null,
    "TimeoutSeconds": 300,
    "MaxTake": 20,
    "AllowedExtensions": [ "jpg", "jpeg", "png", "gif", "webp" ],
    "BlacklistTags": [ "ai-generated", "ai-created", "ai-art", "ai_generated", "ai_created", "ai_art" ],
    "ExtraArgs": [],
    "Resources": {
      "furry34.com": { "UrlTemplate": "https://furry34.com/{query}" }
    }
  }
}
